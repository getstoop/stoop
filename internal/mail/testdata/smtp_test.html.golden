<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<meta name="color-scheme" content="light dark">
<meta name="supported-color-schemes" content="light dark">
<title>Test email from Brownstone</title>
<style>
@media (prefers-color-scheme: dark) {
  .page { background: #141517 !important; }
  .card { background: #24262b !important; border-color: #33363d !important; color: #e6e7ea !important; }
  .muted { color: #9a9da5 !important; }
  .link { color: #e2725b !important; }
  .button { background: #e2725b !important; color: #141517 !important; }
}
@media (max-width: 480px) {
  .card { padding: 20px !important; font-size: 16px !important; }
  .button-table { width: 100% !important; }
  a.button { display: block !important; text-align: center !important; padding: 14px 20px !important; }
}
</style>
</head>
<body class="page" style="margin:0;padding:0;background:#f6f4f0;">
<table role="presentation" class="page" width="100%" cellpadding="0" cellspacing="0" border="0" style="background:#f6f4f0;">
<tr>
<td align="center" style="padding:32px 12px;">
<!--[if mso]><table role="presentation" width="560" align="center" cellpadding="0" cellspacing="0" border="0"><tr><td><![endif]-->
<table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" style="max-width:560px;">
<tr>
<td class="card" style="background:#ffffff;border:1px solid #d9d5cd;border-radius:8px;padding:32px;font-family:system-ui,-apple-system,'Segoe UI',Roboto,Helvetica,Arial,sans-serif;font-size:15px;line-height:1.55;color:#1f1d1a;">
<p class="muted" style="margin:0 0 18px;font-size:14px;font-weight:700;letter-spacing:0.02em;color:#6b675f;">Brownstone</p>
<h1 style="margin:0 0 18px;font-size:22px;line-height:1.3;">Email works</h1>
<p style="margin:0 0 18px;">This is a test from Brownstone's email settings. If you're reading it, Brownstone can send email through smtp.example.net.</p>
<p class="muted" style="margin:0;font-size:13px;color:#6b675f;">Sent at 22:14 UTC on 9 October 2026.</p>
</td>
</tr>
<tr>
<td class="muted" align="center" style="padding:16px 8px 0;font-family:system-ui,-apple-system,'Segoe UI',Roboto,Helvetica,Arial,sans-serif;font-size:12px;line-height:1.5;color:#6b675f;">Sent by Brownstone (chat.example.com). An admin sent this test from Server admin → Email.</td>
</tr>
</table>
<!--[if mso]></td></tr></table><![endif]-->
</td>
</tr>
</table>
</body>
</html>
