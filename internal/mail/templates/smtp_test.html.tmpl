{{define "body" -}}
<h1 style="margin:0 0 18px;font-size:22px;line-height:1.3;">Email works</h1>
<p style="margin:0 0 18px;">This is a test from {{.Site.InstanceName}}'s email settings. If you're reading it, {{.Site.InstanceName}} can send email through {{.Data.Host}}.</p>
<p class="muted" style="margin:0;font-size:13px;color:#6b675f;">Sent at {{clock .Data.SentAt}} on {{day .Data.SentAt}}.</p>
{{- end}}

{{define "footer"}}An admin sent this test from Server admin → Email.{{end}}
