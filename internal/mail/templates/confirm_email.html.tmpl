{{define "body" -}}
<h1 style="margin:0 0 18px;font-size:22px;line-height:1.3;">Confirm your email address</h1>
<p style="margin:0 0 18px;">@{{.Data.Username}} asked to use this address on {{.Site.InstanceName}}. Once it's confirmed, you can use it to get back into your account if you forget your password.</p>
<table role="presentation" class="button-table" cellpadding="0" cellspacing="0" border="0" style="margin:0 0 18px;">
<tr>
<td class="button" style="border-radius:6px;background:#b5482f;"><a class="button" href="{{.Data.Link}}" style="display:inline-block;padding:12px 20px;mso-padding-alt:0;border-radius:6px;background:#b5482f;color:#ffffff;font-weight:600;text-decoration:none;">Confirm email address</a></td>
</tr>
</table>
<p class="muted" style="margin:0 0 18px;font-size:13px;color:#6b675f;">Or open this link:<br><a class="link" href="{{.Data.Link}}" style="color:#b5482f;word-break:break-all;">{{.Data.Link}}</a></p>
<p class="muted" style="margin:0;font-size:13px;color:#6b675f;">The link works once and expires in 24 hours. If you didn't ask for this, ignore this email and nothing will change.</p>
{{- end}}
