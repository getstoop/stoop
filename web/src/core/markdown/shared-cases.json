{
  "about": "Cases the client (web/src/core) and the server (internal/chat) both run, so the two read a message the same way. markdown.test.ts and internal/chat/shared_cases_internal_test.go read this file; add a case here, not to either.",
  "maxMessageLength": 4000,
  "plainText": [
    { "in": "**bold** and *italic*", "want": "bold and italic" },
    { "in": "__under__ ~~gone~~ `code`", "want": "under gone code" },
    { "in": "***both***", "want": "both" },
    { "in": "**hello *world***", "want": "hello world" },
    { "in": "**a *******", "want": "a *****" },
    { "in": "> quoted\n> lines", "want": "quoted lines" },
    { "in": "```go\nfmt.Println()\n```", "want": "fmt.Println()" },
    { "in": "```one liner```", "want": "one liner" },
    { "in": "2 * 3 * 4", "want": "2 * 3 * 4" },
    { "in": "@ada_w said hi", "want": "@ada_w said hi" },
    { "in": "\\*not bold\\*", "want": "*not bold*" },
    { "in": "first\nsecond", "want": "first second" },
    { "in": "plain", "want": "plain" },
    { "in": "", "want": "" },
    { "in": "- milk\n- eggs", "want": "milk eggs" },
    { "in": "* milk\n* eggs", "want": "milk eggs" },
    { "in": "1. first\n2. second", "want": "first second" },
    { "in": "1) first\n2) second", "want": "first second" },
    { "in": "  - nested", "want": "nested" },
    { "in": "||the butler did it||", "want": "the butler did it" },
    { "in": "it was ||him|| all along", "want": "it was him all along" },
    { "in": "- a ||secret|| item", "want": "a secret item" },
    { "in": "**bold** and ||hidden||", "want": "bold and hidden" },
    { "in": "*italic* line", "want": "italic line" },
    { "in": "a || b", "want": "a || b" },
    { "in": "\\- not a list", "want": "- not a list" },
    { "in": "1\\. not a list", "want": "1. not a list" },
    { "in": "  a\n\n  b  ", "want": "a b" },
    { "in": "> quoted\n- item\n```\ncode\n```", "want": "quoted item code" },
    {
      "in": "see https://example.com now",
      "want": "see https://example.com now"
    },
    {
      "in": "see [the docs](https://example.com/a) now",
      "want": "see the docs now"
    },
    { "in": "[**bold** words](https://a.b/x_(y))", "want": "bold words" },
    { "in": "[a](not an address)", "want": "[a](not an address)" },
    {
      "in": "[https://a.example](https://b.example)",
      "want": "[https://a.example](https://b.example)"
    },
    { "in": "\\[a](https://a.b)", "want": "[a](https://a.b)" },
    { "in": "`a *b* c`", "want": "a *b* c" },
    { "in": "```\n- a\n```", "want": "- a" },
    {
      "in": "https://example.com/**not**",
      "want": "https://example.com/**not**"
    },
    { "in": "a *b\nc* d", "want": "a *b c* d" },
    { "in": "> - item", "want": "- item" },
    {
      "in": "hi <@u:00000000-0000-4000-8000-000000000001:casey>",
      "want": "hi @casey"
    },
    {
      "in": "<@u:00000000-0000-4000-8000-000000000001:a__b__c> hi",
      "want": "@a__b__c hi"
    },
    {
      "in": "`<@u:00000000-0000-4000-8000-000000000001:casey>`",
      "want": "@casey"
