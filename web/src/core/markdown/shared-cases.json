    {
      "in": "```c++\nhttps://block.example\n```\nhttps://ok.example",
      "want": ["https://ok.example"]
    },
    {
      "in": "https://dup.example https://dup.example",
      "want": ["https://dup.example"]
    },
    { "in": "`https://a.example`\n```\nhttps://b.example\n```", "want": [] },
    { "in": "ftp://nope.example no links here", "want": [] },
    { "in": "write to <https://a.example/x>", "want": ["https://a.example/x"] },
    {
      "in": "https://example.com/wiki/Ada_(mathematician)",
      "want": ["https://example.com/wiki/Ada_(mathematician)"]
