{
  "name": "stoop-web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "typecheck": "tsc -b && tsc --noEmit -p tsconfig.e2e.json",
    "test": "vitest run",
    "lint": "biome check src e2e-pw e2e",
    "check:themes": "node ../scripts/check-themes.mjs",
    "check:styles": "node ../scripts/check-styles.mjs",
    "format": "biome format --write src e2e-pw e2e"
  },
  "dependencies": {
    "@bufbuild/protobuf": "^2.14.1",
    "@connectrpc/connect": "^2.0.0",
    "@connectrpc/connect-web": "^2.0.0",
    "@tanstack/react-query": "^5.102.8",
    "@tanstack/react-router": "^1.120.0",
    "livekit-client": "^2.22.1",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "zustand": "^5.0.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.11",
    "@playwright/test": "^1.63.0",
    "@types/node": "^22.20.2",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.2.5",
    "@vitejs/plugin-react": "^5.2.0",
    "pg": "^8.23.0",
    "typescript": "^7.0.2",
    "vite": "^6.3.0",
    "vitest": "^5.0.0"
  }
}
