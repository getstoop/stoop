# Copy to .env alongside docker-compose.yml and edit.

# Postgres password (used by both the postgres and stoop services).
POSTGRES_PASSWORD=change-me

# The address people use to reach this server, e.g. https://chat.example.com.
# Invite links are built from it. Leave empty on a LAN-only install or when
# the built-in Tailscale listener is the front door (it fills this in).
STOOP_PUBLIC_URL=

# Set true when a reverse proxy or tunnel you control terminates HTTPS in
# front of Stoop: X-Forwarded-Proto is then honoured for Secure cookies.
STOOP_TRUST_PROXY=false

# Force Secure cookies on every listener. Rarely needed (see above).
STOOP_SECURE_COOKIES=false

# Extra host patterns allowed to open WebSocket connections. The request's
# own host is always allowed, so behind a reverse proxy that forwards the
# Host header (the default) this needs no change; set it only if your
# proxy rewrites Host, e.g. STOOP_ALLOWED_WS_ORIGINS=chat.example.com
STOOP_ALLOWED_WS_ORIGINS=localhost:*

# Uploaded files (avatars, space icons, attachments) are stored on the local filesystem;
# that is the only backend today (STOOP_STORAGE=fs is the default and the
# only accepted value). The compose file mounts the stoop-data volume at
# /data; back it up together with Postgres.
STOOP_STORAGE_DIR=/data

# LiveKit (voice and video). Leave the keys empty: Stoop mints a pair on
# first boot and writes it where the sidecar reads it, so there is nothing
# to copy. Set them only to reuse a pair you already have (e.g. a LiveKit
# you run elsewhere or LiveKit Cloud) — Stoop then uses yours instead.
# The URL is the sidecar's address on the compose network — Stoop proxies
# signaling to it at /livekit — so the default is right for this file.
STOOP_LIVEKIT_URL=http://livekit:7880
STOOP_LIVEKIT_API_KEY=
STOOP_LIVEKIT_API_SECRET=

# TURN relay for voice when browsers can't reach LiveKit's media ports
# (Cloudflare Tunnel, Tailscale Funnel, CGNAT). Easiest: a Cloudflare TURN
# key (dashboard → Realtime → TURN); Stoop mints the credentials itself.
# Or your own relay with fixed credentials. docs/self-hosting.md → TURN.
STOOP_CLOUDFLARE_TURN_KEY_ID=
STOOP_CLOUDFLARE_TURN_API_TOKEN=
STOOP_TURN_URLS=
STOOP_TURN_USERNAME=
STOOP_TURN_CREDENTIAL=
STOOP_STUN_URLS=

# Built-in Tailscale: set true to have Stoop join your tailnet itself and
# serve https://<hostname>.<tailnet>.ts.net (enable HTTPS certificates in
# the tailnet's DNS settings first). Without an auth key the first start
# logs a login URL. See docs/self-hosting.md → Tailscale, built in.
STOOP_TAILSCALE=false
STOOP_TAILSCALE_HOSTNAME=stoop
STOOP_TAILSCALE_AUTHKEY=
STOOP_TAILSCALE_FUNNEL=false

# The built-in node carries LiveKit's media ports as well as the web app,
# so voice and video ride the tailnet with nothing installed on this
# machine. On by default; set false to serve HTTPS over the tailnet only.
STOOP_TAILSCALE_VOICE=true

# The address LiveKit offers browsers as a media candidate. Leave this
# empty: with the built-in Tailscale node, Stoop writes the node's address
# where LiveKit reads it and LiveKit restarts itself to pick it up, so
# there is nothing to do. Set a value here only to pin an address by hand
# — it wins, and switches that off. LiveKit advertises one address, so a
# server reached both over the tailnet and straight from the internet
# wants a TURN relay for the second route.
# See docs/self-hosting.md → Tailscale, built in.
NODE_IP=
