{
  "expo": {
    "name": "Stoop",
    "slug": "stoop",
    "scheme": "stoop",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "org.getstoop.app"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#b5482f",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "monochromeImage": "./assets/android-icon-foreground.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "org.getstoop.app"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-web-browser",
      [
        "expo-notifications",
        {
          "enableRemoteNotifications": false,
          "icon": "./assets/notification-icon.png",
          "color": "#b5482f"
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Stoop lets you pick photos and videos to send in a message.",
          "cameraPermission": "Stoop uses the camera to take photos and videos to send in a message.",
          "microphonePermission": "Stoop uses the microphone to record sound with the videos you send in a message."
        }
      ]
    ]
  }
}
