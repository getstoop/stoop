# Dev-only settings for the hot-reloaded server that `make dev` runs (air
# loads this after .env via env_files in .air.toml). Tracked: nothing here
# is a secret. Starting bin/stoop by hand for a browser or E2E run needs
# these too: `set -a; source .env; source .env.dev; set +a`.
STOOP_DATABASE_URL=postgres://stoop:stoop@localhost:5440/stoop?sslmode=disable
# Dev listens on 8091 (matches the Vite proxy target); prod defaults to :8080.
STOOP_LISTEN_ADDR=:8091
# Link previews in dev may fetch local addresses (the E2E spec serves its
# own page); production must never set this.
STOOP_UNFURL_ALLOW_PRIVATE=true
# The e2e suite registers and signs in dozens of times from localhost, which
# the per-IP login/register throttle (20/min) would refuse. Off in dev only;
# the per-account lockout after 5 wrong passwords stays on.
STOOP_AUTH_RATE_LIMIT=0
# Voice in dev: LiveKit on the host network via scripts/dev-livekit.sh. No
# API key pair here on purpose: the server mints one on first boot and
# writes data/livekit/keys.yaml, which the script starts LiveKit against —
# the same path a self-hoster gets.
STOOP_LIVEKIT_URL=http://localhost:7880
